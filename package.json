{
  "name": "draw-buddy",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./css/tailwind.css --minify",
    "build:vendor": "esbuild vendor-entry.js --bundle --format=esm --platform=browser --outfile=vendor/supabase.js --minify",
    "build": "npm run build:css && npm run build:vendor",
    "stage:www": "node scripts/stage-www.mjs",
    "start": "serve . -l 4173",
    "test": "node --test",
    "cap:sync": "npm run stage:www && cap sync",
    "cap:ios": "npm run stage:www && cap add ios",
    "cap:android": "npm run stage:www && cap add android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@supabase/supabase-js": "^2.81.1",
    "esbuild": "^0.25.11",
    "serve": "^14.2.5",
    "tailwindcss": "^3.4.17"
  }
}
